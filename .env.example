# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ERP Auth (server-only)
AUTH_SESSION_SECRET=replace-with-a-random-64-char-secret
# Optional JSON override for rotating staff passwords without redeploys:
# STAFF_CREDENTIALS_JSON={"usuario@wavesurf.cl":"nueva-clave"}

# Flow Pagos (server-only)
FLOW_API_URL=https://www.flow.cl/api
FLOW_API_KEY=your-flow-api-key
FLOW_SECRET_KEY=your-flow-secret-key
NEXT_PUBLIC_URL=https://wavesurfclub.cl
